# Express server
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# MySQL (copy this file to server/.env and replace every placeholder)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jochwon_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=jochwon
MYSQL_CONNECTION_LIMIT=10

# Authentication and external providers
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AI_PROVIDER=auto
PLACE_PROVIDER=auto
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3001/api/auth/kakao/callback
KAKAO_CLIENT_SECRET=
KAKAO_LOGIN_SCOPES=
KAKAO_SERVICE_TERMS=
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_LOCAL_TIMEOUT_MS=10000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PROMPT_VERSION=1.0.0
OPENAI_TIMEOUT_MS=15000
OPENAI_REQUEST_TIMEOUT_MS=20000
OPENAI_MAX_RETRIES=1
OPENAI_MOCK_ENABLED=false
ALLOW_MOCK_FALLBACK=true
SEJONG_API_KEY=
SEJONG_FESTIVAL_API_URL=http://apis.data.go.kr/5690000/sjFestival/sj_00000360
SEJONG_API_TIMEOUT_MS=10000
TOUR_API_KEY=
TOUR_API_URL=http://apis.data.go.kr/B551011/KorService2/searchFestival2

# Recommendation and cache limits
DEFAULT_SEARCH_REGION=조치원
DEFAULT_SEARCH_RADIUS_METERS=5000
RECOMMENDATION_RESULT_LIMIT=3
MAX_RECOMMENDATION_QUERY_LENGTH=300
MAX_ANALYSIS_MESSAGES=20
CONVERSATION_INTEREST_CACHE_TTL_MS=1800000
CONVERSATION_INTEREST_CACHE_MAX_ITEMS=1000
