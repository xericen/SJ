# Copy the variable names into the deployment secret manager.
# Never put real credentials in this file.
SJ_DB_HOST=db.example.internal
SJ_DB_PORT=3306
SJ_DB_USER=app_user
SJ_DB_PASSWORD=replace-with-a-secret
SJ_DB_NAME=app_database

# WIZ application secrets (config/secret.py or deployment secret manager)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
