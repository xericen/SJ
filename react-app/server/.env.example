# Express server
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# MySQL (copy this file to server/.env and replace every placeholder)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=jochwon_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=jochwon
MYSQL_CONNECTION_LIMIT=10

# Authentication and external providers
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3001/api/auth/kakao/callback
KAKAO_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SEJONG_API_KEY=
TOUR_API_KEY=
