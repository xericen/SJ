doctype html
html.font-loading(lang="ko")
    head
        meta(charset="utf-8")
        title 여기 사람 있음 | 세종 로컬 멀티버스
        base(href="/")
        link(rel="preload" href="/assets/font/SejongGeulggot/SejongGeulggot.ttf" as="font" type="font/ttf" crossorigin="anonymous")
        style.
            html.font-loading body { visibility: hidden; }
        script.
            (() => {
                const reveal = () => document.documentElement.classList.remove('font-loading');
                document.addEventListener('DOMContentLoaded', () => {
                    if (!document.fonts) {
                        reveal();
                        return;
                    }
                    document.fonts.load('400 1em "세종 글꽃체"').then(reveal, reveal);
                });
                window.setTimeout(reveal, 10000);
            })();
        
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(http-equiv="X-UA-Compatible" content="ie=edge")
        meta(name="description" content="실제로 지금 이 동네에 있는 사람들과 연결되는 세종 로컬 멀티버스")
        meta(name="msapplication-TileColor" content="#143D31")
        meta(name="theme-color" content="#143D31")
        meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
        meta(name="apple-mobile-web-app-capable" content="yes")
        meta(name="apple-mobile-web-app-title" content="여기 사람 있음")
        meta(name="mobile-web-app-capable" content="yes")
        meta(name="HandheldFriendly" content="True")
        meta(name="MobileOptimized" content="320")
        link(rel="icon" type="image/svg+xml" href="/assets/brand/here-people.svg")
        link(rel="shortcut icon" href="/assets/brand/icon.ico")
        link(rel="apple-touch-icon" href="/assets/brand/icon.ico")
    body
        app-root
